{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/backend/api/index.js"
    }
  ],
  "functions": {
    "backend/api/index.js": {
      "includeFiles": "backend/node_modules/semver/**"
    },
    "backend/server.js": {
      "includeFiles": "backend/node_modules/semver/**"
    },
    "api/index.js": {
      "includeFiles": "node_modules/semver/**"
    },
    "server.js": {
      "includeFiles": "node_modules/semver/**"
    },
    "**/*.js": {
      "includeFiles": "{backend/,}node_modules/semver/**"
    }
  }
}
