generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MENTOR
  LEARNER
  BOTH
}

enum BadgeLevel {
  BRONZE
  SILVER
  GOLD
  VERIFIED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  phoneNumber    String?  @unique
  collegeName    String?
  department     String?
  year           Int? // Year of study (1-4)
  bio            String?  @db.Text
  profilePicture String? // Cloudinary URL
  mentorSkills   String?  @db.Text // JSON array of mentor skills
  linkedinUrl    String?
  role           UserRole @default(LEARNER)

  // Profile completion
  isProfileComplete Boolean @default(false)

  // Email verification
  isEmailVerified          Boolean   @default(false)
  verificationToken        String?   @unique
  verificationTokenExpires DateTime?
  verifiedAt               DateTime?

  // Gamification (for mentors)
  totalSessions Int         @default(0)
  totalRating   Float       @default(0)
  averageRating Float       @default(0)
  badgeLevel    BadgeLevel?
  points        Int         @default(0)
  totalReviews  Int         @default(0)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relations
  mentorSessions    Session[]          @relation("MentorSessions")
  sessionRequests   SessionRequest[]
  bookings          Booking[]
  reviews           Review[]           @relation("ReviewAuthor")
  receivedReviews   Review[]           @relation("ReviewRecipient")
  resources         Resource[]
  quizzes           Quiz[]
  codingQuestions   CodingQuestion[]
  quizAttempts      QuizAttempt[]
  achievements      UserAchievement[]
  transactions      Transaction[]
  notifications     Notification[]
  codingSubmissions CodingSubmission[]

  // Social Relations
  followers     Follow[] @relation("UserFollowers")
  following     Follow[] @relation("UserFollowing")
  likesReceived Like[]   @relation("UserLikesReceived")
  likesGiven    Like[]   @relation("UserLikesGiven")
  reportsFiled  Report[] @relation("ReportedBy")

  @@index([email])
  @@index([phoneNumber])
  @@index([collegeName])
  @@index([department])
  @@index([role])
  @@index([averageRating])
  @@map("users")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserLikesGiven", fields: [userId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    User     @relation("UserLikesReceived", fields: [mentorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mentorId])
  @@index([userId])
  @@index([mentorId])
  @@map("likes")
}

// SESSION REQUESTS (Mentor → Admin Approval)

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model SessionRequest {
  id String @id @default(uuid())

  // Mentor who requested
  mentorId String
  mentor   User   @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  // Request details
  title       String
  description String @db.Text
  subject     String
  department  String
  topics      String @db.Text // JSON array stored as text

  // Session details
  mode         SessionMode
  priceType    PriceType
  price        Float       @default(0)
  maxSeats     Int
  venue        String? // For offline sessions
  meetingLink  String? // For online sessions
  proposedDate DateTime
  duration     Int // Duration in minutes

  // Approval status
  status           RequestStatus @default(PENDING)
  adminNote        String?       @db.Text
  verificationCall Boolean       @default(false)

  // Timestamps
  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?

  // Relations
  session Session? @relation("ApprovedSession")

  @@index([mentorId])
  @@index([status])
  @@index([requestedAt])
  @@index([subject])
  @@index([department])
  @@map("session_requests")
}

// SESSIONS

enum SessionMode {
  ONLINE
  OFFLINE
}

enum SessionStatus {
  UPCOMING
  LIVE // Session is currently happening
  COMPLETED
  CANCELLED
}

enum PriceType {
  FREE
  PAID
}

model Session {
  id          String @id @default(uuid())
  title       String
  description String @db.Text
  subject     String
  department  String
  topics      String @db.Text // JSON array stored as text

  // Mentor
  mentorId String
  mentor   User   @relation("MentorSessions", fields: [mentorId], references: [id], onDelete: Cascade)

  // Session details
  mode           SessionMode
  priceType      PriceType
  price          Float       @default(0)
  platformFee    Float       @default(0) // Your platform fee
  maxSeats       Int
  availableSeats Int

  // Location/Link
  venue       String? // For offline sessions
  meetingLink String? // For online sessions

  // Scheduling
  scheduledAt DateTime
  duration    Int // Duration in minutes
  status      SessionStatus @default(UPCOMING)

  // Session activity flags
  isLive      Boolean @default(false)
  joinEnabled Boolean @default(false) // Enable "Join" button when session starts

  // Engagement metrics
  totalBookings Int @default(0)
  viewCount     Int @default(0)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relations
  sessionRequest  SessionRequest?  @relation("ApprovedSession", fields: [requestId], references: [id], onDelete: SetNull)
  requestId       String?          @unique
  bookings        Booking[]
  reviews         Review[]
  resources       Resource[]
  quizzes         Quiz[]
  codingQuestions CodingQuestion[]
  reports         Report[]

  @@index([mentorId])
  @@index([subject])
  @@index([department])
  @@index([mode])
  @@index([priceType])
  @@index([scheduledAt])
  @@index([status])
  @@index([availableSeats])
  @@index([isLive])
  @@map("sessions")
}

// BOOKINGS

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id String @id @default(uuid())

  // References
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Booking details
  status     BookingStatus @default(PENDING)
  seatNumber Int?

  // Payment (if applicable)
  amountPaid  Float   @default(0)
  platformFee Float   @default(0)
  totalAmount Float   @default(0)
  paymentId   String? @unique

  // Attendance
  attended Boolean   @default(false)
  joinedAt DateTime? // When learner joined the live session

  // Review eligibility
  canReview   Boolean @default(false) // True after session completion
  hasReviewed Boolean @default(false)

  // Timestamps
  bookedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transaction Transaction?

  @@unique([userId, sessionId]) // User can only book a session once
  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([bookedAt])
  @@index([attended])
  @@map("bookings")
}

// REVIEWS & RATINGS

model Review {
  id String @id @default(uuid())

  // References
  authorId  String
  author    User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    User    @relation("ReviewRecipient", fields: [mentorId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Review content
  rating  Int // 1-5 stars
  comment String? @db.Text

  // Helpful votes (optional)
  helpfulCount Int     @default(0)
  isAnonymous  Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, sessionId]) // One review per user per session
  @@index([mentorId])
  @@index([sessionId])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

// RESOURCES & MATERIALS

enum ResourceType {
  PDF
  PPT
  DOC
  IMAGE
  VIDEO
  LINK
  OTHER
}

model Resource {
  id String @id @default(uuid())

  // References
  uploaderId String
  uploader   User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  sessionId  String
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Resource details
  title       String
  description String?      @db.Text
  fileUrl     String // Cloudinary URL
  fileType    ResourceType
  fileSize    Int? // Size in bytes

  // Access control
  isPublic      Boolean @default(true) // True for session attendees
  downloadCount Int     @default(0)

  // Availability
  availableDuring Boolean @default(true) // Available during session
  availableAfter  Boolean @default(true) // Available after session

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploaderId])
  @@index([sessionId])
  @@index([fileType])
  @@index([createdAt])
  @@map("resources")
}

// QUIZ SYSTEM

enum QuizStatus {
  DRAFT
  LIVE
  CLOSED
}

model Quiz {
  id String @id @default(uuid())

  // References
  creatorId String
  creator   User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Quiz details
  title        String
  description  String? @db.Text
  duration     Int? // Duration in minutes (null for untimed)
  totalMarks   Int     @default(0)
  passingMarks Int     @default(0)

  // Status
  status QuizStatus @default(DRAFT)
  isLive Boolean    @default(false)

  // Availability
  availableDuring Boolean @default(true)
  availableAfter  Boolean @default(true)

  // Launch time
  launchedAt DateTime?
  closedAt   DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  questions Question[]
  attempts  QuizAttempt[]

  @@index([creatorId])
  @@index([sessionId])
  @@index([status])
  @@index([isLive])
  @@map("quizzes")
}

model Question {
  id String @id @default(uuid())

  // References
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  // Question details
  questionText  String @db.Text
  options       String @db.Text // JSON array of options
  correctAnswer String // Correct option
  marks         Int    @default(1)
  order         Int // Question order in quiz

  // Explanation (optional)
  explanation String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  answers Answer[]

  @@index([quizId])
  @@index([order])
  @@map("questions")
}

model QuizAttempt {
  id String @id @default(uuid())

  // References
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  // Attempt details
  score      Int     @default(0)
  totalMarks Int
  isPassed   Boolean @default(false)

  // Timing
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  timeTaken   Int? // Time taken in seconds

  // Relations
  answers Answer[]

  @@index([userId])
  @@index([quizId])
  @@index([startedAt])
  @@map("quiz_attempts")
}

model Answer {
  id String @id @default(uuid())

  // References
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Answer details
  selectedAnswer String
  isCorrect      Boolean @default(false)
  marksObtained  Int     @default(0)

  // Timestamps
  answeredAt DateTime @default(now())

  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

// GAMIFICATION & ACHIEVEMENTS

enum AchievementType {
  SESSIONS_COMPLETED
  HIGH_RATING
  LEARNERS_HELPED
  PERFECT_ATTENDANCE
  EARLY_ADOPTER
  RESOURCE_CONTRIBUTOR
  QUIZ_MASTER
  FIRST_SESSION
}

model Achievement {
  id          String          @id @default(uuid())
  name        String          @unique
  description String          @db.Text
  type        AchievementType
  requirement Int // Threshold to unlock
  badgeIcon   String? // Icon URL
  points      Int             @default(0)

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  userAchievements UserAchievement[]

  @@index([type])
  @@map("achievements")
}

model UserAchievement {
  id String @id @default(uuid())

  // References
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  // Achievement details
  unlockedAt DateTime @default(now())
  progress   Int      @default(0)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

// PAYMENTS & TRANSACTIONS

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  PHONEPE
  UPI
  CARD
  NETBANKING
}

model Transaction {
  id String @id @default(uuid())

  // References
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Transaction details
  amount        Float // Session price
  platformFee   Float // Your platform fee
  totalAmount   Float // Total charged
  currency      String            @default("INR")
  status        TransactionStatus @default(PENDING)
  paymentMethod PaymentMethod?

  // Payment gateway details (Razorpay/PhonePe)
  gatewayOrderId   String? @unique
  gatewayPaymentId String? @unique
  gatewaySignature String?

  // Timestamps
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

// NOTIFICATIONS

enum NotificationType {
  BOOKING_CONFIRMED
  SESSION_REMINDER
  SESSION_STARTING
  SESSION_LIVE
  SESSION_COMPLETED
  SESSION_CANCELLED
  NEW_REVIEW
  ACHIEVEMENT_UNLOCKED
  PAYMENT_SUCCESS
  SEAT_AVAILABLE
  QUIZ_LAUNCHED
  RESOURCE_UPLOADED
  SESSION_REQUEST_APPROVED
  SESSION_REQUEST_REJECTED
}

model Notification {
  id String @id @default(uuid())

  // References
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification details
  type    NotificationType
  title   String
  message String           @db.Text
  link    String?

  // Status
  isRead Boolean @default(false)

  // Timestamps
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// REPORTS & FLAGGED CONTENT

enum ReportStatus {
  PENDING
  RESOLVED
  IGNORED
}

model Report {
  id String @id @default(uuid())

  // References
  reporterId String
  reporter   User   @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Report details
  reason String       @db.Text
  status ReportStatus @default(PENDING)

  // Timestamps
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([reporterId])
  @@index([sessionId])
  @@index([status])
  @@map("reports")
}

model CodingQuestion {
  id String @id @default(uuid())

  // References
  creatorId String
  creator   User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Details
  title       String
  description String @db.Text
  testCases   String @db.Text // JSON strings like [{input: "1", output: "2"}]
  difficulty  String @default("MEDIUM")

  // Status
  status QuizStatus @default(DRAFT)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions CodingSubmission[]

  @@index([creatorId])
  @@index([sessionId])
  @@map("coding_questions")
}

model CodingSubmission {
  id String @id @default(uuid())

  // References
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  codingQuestionId String
  codingQuestion   CodingQuestion @relation(fields: [codingQuestionId], references: [id], onDelete: Cascade)

  // Submission details
  code     String @db.Text
  language String
  status   String // PASSED, FAILED

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([codingQuestionId])
  @@map("coding_submissions")
}
