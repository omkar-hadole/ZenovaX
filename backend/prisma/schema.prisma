generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MENTOR
  LEARNER
  BOTH
}

enum BadgeLevel {
  BRONZE
  SILVER
  GOLD
  VERIFIED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String
  phoneNumber         String?   @unique
  department          String?
  year                Int?
  bio                 String?
  profilePicture      String?
  mentorSkills        String?
  linkedinUrl         String?
  role                UserRole  @default(LEARNER)

  isProfileComplete   Boolean   @default(false)
  isPhoneVisible      Boolean   @default(true)

  isEmailVerified     Boolean   @default(false)
  verificationToken   String?   @unique
  verificationTokenExpires DateTime?
  verifiedAt          DateTime?

  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?

  totalSessions       Int       @default(0)
  averageRating       Float     @default(0)
  badgeLevel          BadgeLevel?
  points              Int       @default(0)
  totalReviews        Int       @default(0)
  uniqueLearners      Int       @default(0)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?

  mentorSessions      Session[] @relation("MentorSessions")
  sessionRequests     SessionRequest[]
  learningRequests    LearningRequest[]
  learningRequestInterests LearningRequestInterest[]
  bookings            Booking[]
  reviews             Review[]  @relation("ReviewAuthor")
  receivedReviews     Review[]  @relation("ReviewRecipient")
  resources           Resource[]
  quizzes             Quiz[]
  codingQuestions     CodingQuestion[]
  quizAttempts        QuizAttempt[]
  transactions        Transaction[]
  notifications       Notification[]
  codingSubmissions   CodingSubmission[]
  mentorWallet        MentorWallet?
  mentorPayouts       MentorPayout[]
  mentorPayoutAccount MentorPayoutAccount?

  followers           Follow[]  @relation("UserFollowers")
  following           Follow[]  @relation("UserFollowing")
  likesReceived       Like[]    @relation("UserLikesReceived")
  likesGiven          Like[]    @relation("UserLikesGiven")
  reportsFiled        Report[]  @relation("ReportedBy")
  refreshTokens       RefreshToken[]
  deviceTokens        String?
  adminNotificationLogs AdminNotificationLog[] @relation("AdminNotificationLogs")

  @@index([email])
  @@index([phoneNumber])
  @@index([department])
  @@index([role])
  @@index([role, isProfileComplete])
  @@index([averageRating])
  @@index([isDeleted])
  @@map("users")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserLikesGiven", fields: [userId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    User     @relation("UserLikesReceived", fields: [mentorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mentorId])
  @@index([userId])
  @@index([mentorId])
  @@map("likes")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LearningRequestStatus {
  OPEN
  SESSION_CREATED
  COMPLETED
  CLOSED
}

enum PreferredMode {
  ONLINE
  OFFLINE
  EITHER
}

model SessionRequest {
  id              String        @id @default(uuid())

  mentorId        String
  mentor          User          @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  subject         String
  department      String
  topics          String?

  mode            SessionMode
  priceType       PriceType
  price           Float         @default(0)
  maxSeats        Int
  venue           String?
  meetingLink     String?
  proposedDate    DateTime
  duration        Int

  status          RequestStatus @default(PENDING)
  adminNote       String?
  verificationCall Boolean     @default(false)

  requestedAt     DateTime      @default(now())
  reviewedAt      DateTime?

  session         Session?      @relation("ApprovedSession")

  learningRequest LearningRequest? @relation("LearningRequestSessionRequests", fields: [learningRequestId], references: [id], onDelete: SetNull)
  learningRequestId String?        @unique

  @@index([mentorId])
  @@index([status])
  @@index([requestedAt])
  @@index([subject])
  @@index([department])
  @@index([topics])
  @@map("session_requests")
}

model LearningRequest {
  id              String                @id @default(uuid())

  creatorId       String
  creator         User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  topic           String
  description     String
  preferredMode   PreferredMode         @default(EITHER)
  isAnonymous     Boolean               @default(false)

  status          LearningRequestStatus @default(OPEN)

  sessionId       String?               @unique
  session         Session?              @relation("LearningRequestSession", fields: [sessionId], references: [id], onDelete: SetNull)

  sessionRequests SessionRequest[]      @relation("LearningRequestSessionRequests")
  interests       LearningRequestInterest[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([topic])
  @@index([preferredMode])
  @@index([createdAt])
  @@map("learning_requests")
}

model LearningRequestInterest {
  id                String          @id @default(uuid())

  learningRequestId String
  learningRequest   LearningRequest @relation(fields: [learningRequestId], references: [id], onDelete: Cascade)
  learnerId         String
  learner           User            @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@unique([learningRequestId, learnerId])
  @@index([learnerId])
  @@index([learningRequestId])
  @@map("learning_request_interests")
}

enum SessionMode {
  ONLINE
  OFFLINE
}

enum SessionStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum PriceType {
  FREE
  PAID
}

model Session {
  id              String        @id @default(uuid())
  title           String
  description     String?
  subject         String
  department      String
  topics          String?

  mentorId        String
  mentor          User          @relation("MentorSessions", fields: [mentorId], references: [id], onDelete: Cascade)

  mode            SessionMode
  priceType       PriceType
  price           Float         @default(0)
  platformFee     Float         @default(0)
  maxSeats        Int
  availableSeats  Int

  venue           String?
  meetingLink     String?

  scheduledAt     DateTime
  duration        Int
  status          SessionStatus @default(UPCOMING)

  isLive          Boolean       @default(false)
  joinEnabled     Boolean       @default(false)

  totalBookings   Int           @default(0)
  viewCount       Int           @default(0)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?

  sessionRequest  SessionRequest? @relation("ApprovedSession", fields: [requestId], references: [id], onDelete: SetNull)
  requestId       String?         @unique
  learningRequest LearningRequest? @relation("LearningRequestSession")
  learningRequestId String?       @unique
  bookings        Booking[]
  reviews         Review[]
  resources       Resource[]
  quizzes         Quiz[]
  codingQuestions CodingQuestion[]
  reports         Report[]

  @@index([mentorId])
  @@index([subject])
  @@index([department])
  @@index([mode])
  @@index([priceType])
  @@index([scheduledAt])
  @@index([status])
  @@index([availableSeats])
  @@index([isLive])
  @@index([topics])
  @@index([status, scheduledAt])
  @@index([mentorId, status])
  @@index([isDeleted])
  @@map("sessions")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id              String        @id @default(uuid())

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  status          BookingStatus @default(PENDING)
  seatNumber      Int?

  amountPaid      Float         @default(0)
  platformFee     Float         @default(0)
  totalAmount     Float         @default(0)
  paymentId       String?       @unique
  earningsReleased Boolean     @default(false)

  attended        Boolean       @default(false)
  joinedAt        DateTime?

  canReview       Boolean       @default(false)
  hasReviewed     Boolean       @default(false)

  bookedAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transaction     Transaction?

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
  @@index([sessionId, status])
  @@index([status])
  @@index([bookedAt])
  @@index([attended])
  @@map("bookings")
}

model Review {
  id              String    @id @default(uuid())

  authorId        String
  author          User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mentorId        String
  mentor          User      @relation("ReviewRecipient", fields: [mentorId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  rating          Int
  comment         String?

  helpfulCount    Int       @default(0)
  isAnonymous     Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([authorId, sessionId])
  @@index([mentorId])
  @@index([sessionId])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

enum ResourceType {
  PDF
  PPT
  DOC
  IMAGE
  VIDEO
  LINK
  OTHER
}

model Resource {
  id              String        @id @default(uuid())

  uploaderId      String
  uploader        User          @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  fileUrl         String
  fileType        ResourceType
  fileSize        Int?

  isPublic        Boolean       @default(true)
  downloadCount   Int           @default(0)

  availableDuring Boolean       @default(true)
  availableAfter  Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([uploaderId])
  @@index([sessionId])
  @@index([fileType])
  @@index([createdAt])
  @@map("resources")
}

enum QuizStatus {
  DRAFT
  LIVE
  CLOSED
}

model Quiz {
  id              String        @id @default(uuid())

  creatorId       String
  creator         User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  duration        Int?
  totalMarks      Int           @default(0)
  passingMarks    Int           @default(0)

  status          QuizStatus    @default(DRAFT)
  isLive          Boolean       @default(false)

  availableDuring Boolean       @default(true)
  availableAfter  Boolean       @default(true)

  launchedAt      DateTime?
  closedAt        DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  questions       Question[]
  attempts        QuizAttempt[]

  @@index([creatorId])
  @@index([sessionId])
  @@index([status])
  @@index([isLive])
  @@map("quizzes")
}

model Question {
  id              String    @id @default(uuid())

  quizId          String
  quiz            Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionText    String?
  options         String?
  correctAnswer   String
  marks           Int       @default(1)
  order           Int

  explanation     String?

  createdAt       DateTime  @default(now())

  answers         Answer[]

  @@index([quizId])
  @@index([order])
  @@map("questions")
}

model QuizAttempt {
  id              String    @id @default(uuid())

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId          String
  quiz            Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  score           Int       @default(0)
  totalMarks      Int
  isPassed        Boolean   @default(false)

  startedAt       DateTime  @default(now())
  submittedAt     DateTime?
  timeTaken       Int?

  answers         Answer[]

  @@index([userId])
  @@index([quizId])
  @@index([startedAt])
  @@map("quiz_attempts")
}

model Answer {
  id              String      @id @default(uuid())

  attemptId       String
  attempt         QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedAnswer  String
  isCorrect       Boolean     @default(false)
  marksObtained   Int         @default(0)

  answeredAt      DateTime    @default(now())

  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  PHONEPE
  UPI
  CARD
  NETBANKING
}

model Transaction {
  id                String            @id @default(uuid())

  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId         String            @unique
  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount            Float
  platformFee       Float
  totalAmount       Float
  currency          String            @default("INR")
  status            TransactionStatus @default(PENDING)
  paymentMethod     PaymentMethod?

  gatewayOrderId    String?           @unique
  gatewayPaymentId  String?           @unique
  gatewaySignature  String?

  createdAt         DateTime          @default(now())
  completedAt       DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum LedgerEntryType {
  BOOKING_CREDIT
  RELEASE
  PAYOUT
  REVERSAL
}

model MentorWallet {
  id               String   @id @default(uuid())
  mentorId         String   @unique
  mentor           User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  balancePending   Float    @default(0)
  balanceAvailable Float    @default(0)
  totalEarned      Float    @default(0)
  totalPaidOut     Float    @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ledgerEntries    MentorLedgerEntry[]
  payouts          MentorPayout[]

  @@map("mentor_wallets")
}

model MentorLedgerEntry {
  id          String          @id @default(uuid())

  walletId    String
  wallet      MentorWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type        LedgerEntryType
  amount      Float
  description String?

  bookingId   String?
  payoutId    String?
  payout      MentorPayout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt   DateTime        @default(now())

  @@index([walletId])
  @@index([walletId, createdAt])
  @@index([bookingId])
  @@index([type])
  @@map("mentor_ledger_entries")
}

model MentorPayout {
  id              String       @id @default(uuid())

  walletId        String
  wallet          MentorWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  mentorId        String
  mentor          User         @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  amount          Float
  status          PayoutStatus @default(PENDING)
  currency        String       @default("INR")

  gatewayPayoutId String?      @unique
  failureReason   String?

  requestedAt     DateTime     @default(now())
  processedAt     DateTime?

  ledgerEntries   MentorLedgerEntry[]

  @@index([mentorId])
  @@index([status])
  @@map("mentor_payouts")
}

model MentorPayoutAccount {
  id                     String    @id @default(uuid())
  mentorId               String    @unique
  mentor                 User      @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  accountHolderName      String?
  bankAccountNumber      String?
  ifscCode               String?
  upiId                  String?

  kycStatus              KycStatus @default(NOT_SUBMITTED)
  gatewayLinkedAccountId String?   @unique
  submittedAt            DateTime?
  verifiedAt             DateTime?
  rejectionReason        String?

  updatedAt              DateTime  @updatedAt

  @@map("mentor_payout_accounts")
}

enum NotificationType {
  BOOKING_CONFIRMED
  SESSION_REMINDER
  SESSION_STARTING
  SESSION_LIVE
  SESSION_COMPLETED
  SESSION_CANCELLED
  NEW_REVIEW
  ACHIEVEMENT_UNLOCKED
  PAYMENT_SUCCESS
  SEAT_AVAILABLE
  QUIZ_LAUNCHED
  CODING_QUESTION_LAUNCHED
  RESOURCE_UPLOADED
  SESSION_REQUEST_APPROVED
  SESSION_REQUEST_REJECTED
  LEARNING_REQUEST_SESSION_CREATED
  ADMIN_BROADCAST
}

enum AudienceType {
  ALL
  LEARNERS
  MENTORS
  COURSE_ENROLLED
  SINGLE_USER
}

model Notification {
  id              String            @id @default(uuid())

  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            NotificationType
  title           String
  message         String?
  link            String?

  isRead          Boolean           @default(false)

  createdAt       DateTime          @default(now())
  readAt          DateTime?

  @@index([userId])
  @@index([userId, isRead])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AdminNotificationLog {
  id            String       @id @default(uuid())
  adminId       String
  admin         User         @relation("AdminNotificationLogs", fields: [adminId], references: [id])
  title         String
  message       String?
  link          String?
  audienceType  AudienceType
  audienceId    String?
  totalSent     Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_notification_logs")
}

enum ReportStatus {
  PENDING
  RESOLVED
  IGNORED
}

model Report {
  id              String        @id @default(uuid())

  reporterId      String
  reporter        User          @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)

  sessionId       String?
  session         Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  reason          String?
  status          ReportStatus  @default(PENDING)

  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  @@index([reporterId])
  @@index([sessionId])
  @@index([status])
  @@map("reports")
}

model CodingQuestion {
  id              String        @id @default(uuid())

  creatorId       String
  creator         User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  testCases       String?
  difficulty      String        @default("MEDIUM")

  allowedLanguages   String?
  starterCode        String?
  referenceSolution  String?
  timeLimitMinutes   Int?
  points             Int?       @default(100)

  questionType         String?   @default("legacy")
  functionName         String?
  parameters           String?
  returnType           String?
  structuredTestCases  String?

  status          QuizStatus    @default(DRAFT)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  submissions     CodingSubmission[]

  @@index([creatorId])
  @@index([sessionId])
  @@index([status])
  @@map("coding_questions")
}

model CodingSubmission {
  id               String         @id @default(uuid())

  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  codingQuestionId String
  codingQuestion   CodingQuestion @relation(fields: [codingQuestionId], references: [id], onDelete: Cascade)

  language         String
  status           String

  createdAt        DateTime       @default(now())

  @@index([userId])
  @@index([codingQuestionId])
  @@index([userId, codingQuestionId])
  @@map("coding_submissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
  @@index([userId, revoked])
  @@map("refresh_tokens")
}