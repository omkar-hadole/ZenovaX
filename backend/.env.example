# Database configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Cloudinary credentials (for image/video storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI APIs
GEMINI_API_KEY=your_gemini_api_key

# Cache & Message Queue
REDIS_URL=redis://localhost:6379

# Email SMTP configuration (for system notifications/auth)
GMAIL_USER=your_gmail_username@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_key
CSRF_SECRET=your_csrf_secret_key

# Node Environment & Server Ports
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Extra CORS origins (comma-separated). Add your AWS Amplify URL here in prod,
# e.g. https://main.d1234abcd.amplifyapp.com  (or your custom domain)
ALLOWED_ORIGINS=

# Logging configuration (e.g. error, warn, info, verbose, debug, silly)
LOG_LEVEL=info

# Code execution environment
PISTON_API_URL=https://emkc.org/api/v2/piston

# 8x8 JaaS Video Conferencing Integration
JAAS_APP_ID=your_jaas_app_id
JAAS_API_KEY_ID=your_jaas_api_key_id
JAAS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_PEM_HERE\n-----END RSA PRIVATE KEY-----"

