# Database configuration
# DATABASE_URL: Transaction mode (PgBouncer compatible) — port 6543 for Supabase
# DIRECT_URL: Direct connection for Prisma migrations — port 5432 for Supabase
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require

# Cloudinary credentials (for image/video storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI APIs
GEMINI_API_KEY=your_gemini_api_key

# Cache & Message Queue
REDIS_URL=redis://localhost:6379

# Email SMTP configuration (for system notifications/auth)
# service defaults to 'gmail'; override EMAIL_SERVICE for other providers.
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail_username@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="ZenovaX Support" <noreply@zenovax.com>

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_key
CSRF_SECRET=your_csrf_secret_key

# Node Environment & Server Ports
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Extra CORS origins (comma-separated). Add your AWS Amplify URL here in prod,
# e.g. https://main.d1234abcd.amplifyapp.com  (or your custom domain)
ALLOWED_ORIGINS=

# Logging configuration (e.g. error, warn, info, verbose, debug, silly)
LOG_LEVEL=info

# Code execution environment
# JavaScript runs locally via a worker_thread (jsRunner.js) — no config needed.
# Python runs locally via Pyodide (pyodideRunner.js) — no config needed.
# PISTON_API_URL is only used for Java execution. The public emkc.org endpoint
# became auth-gated in Feb 2026; self-host Piston and point this at it for Java.
PISTON_API_URL=

# 8x8 JaaS Video Conferencing Integration
JAAS_APP_ID=your_jaas_app_id
JAAS_API_KEY_ID=your_jaas_api_key_id
JAAS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_PEM_HERE\n-----END RSA PRIVATE KEY-----"

# Payments (Razorpay). Leave BLANK to run the simulated payment flow in dev
# (paid bookings confirm instantly, no real charge). Set these to enable real
# checkout. Get test keys from the Razorpay dashboard (Settings > API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Razorpay dashboard > Webhooks). Point the webhook at
# POST {backend}/api/payments/webhook and subscribe to payment.captured,
# order.paid, and payment.failed events.
RAZORPAY_WEBHOOK_SECRET=

# Platform commission taken from each paid booking (percent of price). The rest
# is credited to the mentor's wallet. Default 15.
PLATFORM_FEE_PERCENT=15
# Minutes a PENDING (awaiting-payment) booking holds its seat before auto-release.
BOOKING_HOLD_MINUTES=15

